# 复制为 .env 后按需修改；所有变量都有默认值，不配置也能直接跑。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# 可选：接入你自己的同构历史看板（提供 /data.js、/api/kline、/api/hq）。
# 留空则完全使用仓库内置的静态种子，不请求任何私有服务。
ETF_BOARD_ORIGIN=

# 每 IP 每分钟允许的 /v1/ 请求数，0 表示关闭进程内限流。
ETF_RATE_LIMIT_PER_MIN=120

# 需要走系统 HTTP 代理时设为 1（默认 0，避免本机代理把行情请求劫持成空响应）。
ETF_TRUST_ENV=0

# 缓存落盘位置，留空用系统临时目录。
ETF_CUM_CACHE=
ETF_BUNDLE_CACHE=
